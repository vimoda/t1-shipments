T1_CLIENT_ID=your_client_id
T1_CLIENT_SECRET=your_client_secret
T1_USERNAME=your_username
T1_PASSWORD=your_password

# Environment: dev | prod (selects URL preset)
T1_ENV=dev

# Optional: override URLs from preset
# T1_BASE_URL=https://xxxx.xxx.com
# T1_AUTH_URL=https://xxxx.com

T1_SHOP_ID=xxxxxxx
T1_COMERCE_ID=xxxx

T1_TIMEOUT=30.0
# T1_RETRIES=3         # reintentos en 5xx / timeout (default: 3)
# T1_LOG_LEVEL=DEBUG   # DEBUG | INFO | WARNING | ERROR
